.env
.env.local
.env.*.local
*.env

# Certificados y claves de acceso a servicios en la nube
*.pem
*.key
*.pfx
secrets.json
config.json


# ==========================================
# 5. BASES DE DATOS LOCALES Y ARCHIVOS PESADOS (SQL / DUCKDB)
